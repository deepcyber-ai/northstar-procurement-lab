# Local development defaults. Copy this file to .env before starting the lab.
#
# Keep the local default bound to loopback. The AWS deployment supplies
# LAB_BIND_ADDRESS=0.0.0.0 on an EC2 instance protected by a source-IP rule.
LAB_BIND_ADDRESS=127.0.0.1
LAB_PORT=8080

# Owner controls use a separate ignored owner-control/.env, generated with:
# python3 owner-control/configure_owner.py
# The initial profile enables all exercises; use owner controls for Fixed mode.
# Safe callback processing is disabled unless a separate >=32-character secret is set.
LAB_CALLBACK_TOKEN=
